<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whut.cs.bi.biz.mapper.AssessAbsentMarkMapper">

    <resultMap type="AssessAbsentMark" id="AssessAbsentMarkResult">
        <result property="id"             column="id"/>
        <result property="taskId"         column="task_id"/>
        <result property="unitId"         column="unit_id"/>
        <result property="unitUuid"       column="unit_uuid"/>
        <result property="spanId"         column="span_id"/>
        <result property="spanUuid"       column="span_uuid"/>
        <result property="partKey"        column="part_key"/>
        <result property="layerKey"       column="layer_key"/>
        <result property="evidence"       column="evidence"/>
        <result property="offlineUuid"    column="offline_uuid"/>
        <result property="isOfflineData"  column="is_offline_data"/>
        <result property="offlineDeleted" column="offline_deleted"/>
        <result property="createBy"       column="create_by"/>
        <result property="createTime"     column="create_time"/>
        <result property="updateBy"       column="update_by"/>
        <result property="updateTime"     column="update_time"/>
        <result property="remark"         column="remark"/>
    </resultMap>

    <sql id="selectAssessAbsentMarkVo">
        select id, task_id, unit_id, unit_uuid, span_id, span_uuid, part_key, layer_key, evidence,
               offline_uuid, is_offline_data, offline_deleted,
               create_by, create_time, update_by, update_time, remark
        from bi_assess_absent_mark
    </sql>

    <select id="selectByOfflineUuid" parameterType="String" resultMap="AssessAbsentMarkResult">
        <include refid="selectAssessAbsentMarkVo"/>
        where offline_uuid = #{offlineUuid} limit 1
    </select>

    <select id="selectByTaskId" resultMap="AssessAbsentMarkResult">
        <include refid="selectAssessAbsentMarkVo"/>
        where task_id = #{taskId}
        order by id
    </select>

    <select id="selectByTaskIds" resultMap="AssessAbsentMarkResult">
        <include refid="selectAssessAbsentMarkVo"/>
        where task_id in
        <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
        order by id
    </select>

    <insert id="insertAssessAbsentMark" parameterType="AssessAbsentMark" useGeneratedKeys="true" keyProperty="id">
        insert into bi_assess_absent_mark
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="unitId != null">unit_id,</if>
            <if test="unitUuid != null">unit_uuid,</if>
            <if test="spanId != null">span_id,</if>
            <if test="spanUuid != null">span_uuid,</if>
            <if test="partKey != null">part_key,</if>
            <if test="layerKey != null">layer_key,</if>
            <if test="evidence != null">evidence,</if>
            <if test="offlineUuid != null">offline_uuid,</if>
            <if test="isOfflineData != null">is_offline_data,</if>
            <if test="offlineDeleted != null">offline_deleted,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="unitId != null">#{unitId},</if>
            <if test="unitUuid != null">#{unitUuid},</if>
            <if test="spanId != null">#{spanId},</if>
            <if test="spanUuid != null">#{spanUuid},</if>
            <if test="partKey != null">#{partKey},</if>
            <if test="layerKey != null">#{layerKey},</if>
            <if test="evidence != null">#{evidence},</if>
            <if test="offlineUuid != null">#{offlineUuid},</if>
            <if test="isOfflineData != null">#{isOfflineData},</if>
            <if test="offlineDeleted != null">#{offlineDeleted},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAssessAbsentMark" parameterType="AssessAbsentMark">
        update bi_assess_absent_mark
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="unitId != null">unit_id = #{unitId},</if>
            <if test="unitUuid != null">unit_uuid = #{unitUuid},</if>
            <if test="spanId != null">span_id = #{spanId},</if>
            <if test="spanUuid != null">span_uuid = #{spanUuid},</if>
            <if test="partKey != null">part_key = #{partKey},</if>
            <if test="layerKey != null">layer_key = #{layerKey},</if>
            <if test="evidence != null">evidence = #{evidence},</if>
            <if test="isOfflineData != null">is_offline_data = #{isOfflineData},</if>
            <if test="offlineDeleted != null">offline_deleted = #{offlineDeleted},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAssessAbsentMarkById" parameterType="Long">
        delete from bi_assess_absent_mark where id = #{id}
    </delete>

</mapper>
