<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whut.cs.bi.biz.mapper.LoDiseaseTypeMapper">

    <resultMap type="LoDiseaseType" id="LoDiseaseTypeResult">
        <result property="id"            column="id"              />
        <result property="leafObjectId"  column="leaf_object_id"  />
        <result property="diseaseTypeId" column="disease_type_id" />
        <result property="createTime"    column="create_time"     />
    </resultMap>

    <sql id="selectLoDiseaseTypeVo">
        select id, leaf_object_id, disease_type_id, create_time
        from bi_lo_disease_type
    </sql>

    <select id="selectLoDiseaseTypeList" parameterType="LoDiseaseType" resultMap="LoDiseaseTypeResult">
        <include refid="selectLoDiseaseTypeVo"/>
        <where>
            <if test="leafObjectId != null"> and leaf_object_id = #{leafObjectId}</if>
            <if test="diseaseTypeId != null"> and disease_type_id = #{diseaseTypeId}</if>
        </where>
        order by id
    </select>

</mapper>
