<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whut.cs.bi.biz.mapper.RssDiseaseTypeMapper">

    <resultMap type="RssDiseaseType" id="RssDiseaseTypeResult">
        <result property="id"                                column="id"                                />
        <result property="repairStrengtheningStructureId"    column="repair_strengthening_structure_id"/>
        <result property="diseaseTypeId"                     column="disease_type_id"                   />
        <result property="createTime"                        column="create_time"                       />
    </resultMap>

    <sql id="selectRssDiseaseTypeVo">
        select id, repair_strengthening_structure_id, disease_type_id, create_time
        from bi_rss_disease_type
    </sql>

    <select id="selectRssDiseaseTypeList" parameterType="RssDiseaseType" resultMap="RssDiseaseTypeResult">
        <include refid="selectRssDiseaseTypeVo"/>
        <where>
            <if test="repairStrengtheningStructureId != null">
                and repair_strengthening_structure_id = #{repairStrengtheningStructureId}
            </if>
            <if test="diseaseTypeId != null"> and disease_type_id = #{diseaseTypeId}</if>
        </where>
        order by id
    </select>

</mapper>
