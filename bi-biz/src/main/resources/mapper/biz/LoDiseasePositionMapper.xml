<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whut.cs.bi.biz.mapper.LoDiseasePositionMapper">

    <resultMap type="LoDiseasePosition" id="LoDiseasePositionResult">
        <result property="id"           column="id"             />
        <result property="leafObjectId" column="leaf_object_id" />
        <result property="position"     column="position"       />
        <result property="ref1"         column="ref1"           />
        <result property="ref2"         column="ref2"           />
        <result property="createTime"   column="create_time"    />
    </resultMap>

    <sql id="selectLoDiseasePositionVo">
        select id, leaf_object_id, position, ref1, ref2, create_time
        from bi_lo_disease_position
    </sql>

    <select id="selectLoDiseasePositionList" parameterType="LoDiseasePosition" resultMap="LoDiseasePositionResult">
        <include refid="selectLoDiseasePositionVo"/>
        <where>
            <if test="leafObjectId != null"> and leaf_object_id = #{leafObjectId}</if>
            <if test="position != null and position != ''"> and position = #{position}</if>
        </where>
        order by id
    </select>

</mapper>
