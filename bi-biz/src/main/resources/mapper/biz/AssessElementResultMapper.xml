<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.whut.cs.bi.biz.mapper.AssessElementResultMapper">

    <resultMap type="AssessElementResult" id="AssessElementResultResult">
        <result property="id"           column="id"/>
        <result property="taskId"       column="task_id"/>
        <result property="unitId"       column="unit_id"/>
        <result property="spanId"       column="span_id"/>
        <result property="partId"       column="part_id"/>
        <result property="partKey"      column="part_key"/>
        <result property="layerKey"     column="layer_key"/>
        <result property="elementUuid"  column="element_uuid"/>
        <result property="elementName"  column="element_name"/>
        <result property="isMain"       column="is_main"/>
        <result property="isShared"     column="is_shared"/>
        <result property="absentFlag"   column="absent_flag"/>
        <result property="eddi"         column="eddi"/>
        <result property="esdi"         column="esdi"/>
        <result property="edi"          column="edi"/>
        <result property="efi"          column="efi"/>
        <result property="eai"          column="eai"/>
        <result property="eci"          column="eci"/>
        <result property="ecl"          column="ecl"/>
        <result property="eddiSource"   column="eddi_source"/>
        <result property="esdiSource"   column="esdi_source"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
    </resultMap>

    <sql id="selectAssessElementResultVo">
        select id, task_id, unit_id, span_id, part_id, part_key, layer_key, element_uuid, element_name,
               is_main, is_shared, absent_flag, eddi, esdi, edi, efi, eai, eci, ecl,
               eddi_source, esdi_source, create_by, create_time
        from bi_assess_element_result
    </sql>

    <delete id="deleteByTaskId">
        delete from bi_assess_element_result where task_id = #{taskId}
    </delete>

    <insert id="batchInsert">
        insert into bi_assess_element_result
            (task_id, unit_id, span_id, part_id, part_key, layer_key, element_uuid, element_name,
             is_main, is_shared, absent_flag, eddi, esdi, edi, efi, eai, eci, ecl,
             eddi_source, esdi_source, create_by, create_time)
        values
        <foreach collection="list" item="row" separator=",">
            (#{row.taskId}, #{row.unitId}, #{row.spanId}, #{row.partId}, #{row.partKey}, #{row.layerKey},
             #{row.elementUuid}, #{row.elementName},
             #{row.isMain}, #{row.isShared}, #{row.absentFlag},
             #{row.eddi}, #{row.esdi}, #{row.edi}, #{row.efi}, #{row.eai}, #{row.eci}, #{row.ecl},
             #{row.eddiSource}, #{row.esdiSource}, #{row.createBy}, now())
        </foreach>
    </insert>

    <select id="selectByTaskId" resultMap="AssessElementResultResult">
        <include refid="selectAssessElementResultVo"/>
        where task_id = #{taskId}
        order by unit_id, span_id, layer_key, part_id, id
    </select>
</mapper>
